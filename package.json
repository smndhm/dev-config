{
  "name": "@dume/dev-config",
  "version": "1.4.0",
  "description": "The configuration shared by my projects: Prettier, oxlint, ESLint and Stylelint configurations, a pre-commit hook with husky and lint-staged, accessibility checks with axe-core and Playwright, and Claude Code settings",
  "keywords": [
    "a11y",
    "axe-core",
    "eslint",
    "husky",
    "lint-staged",
    "oxlint",
    "prettier",
    "stylelint"
  ],
  "homepage": "https://github.com/smndhm/dev-config#readme",
  "bugs": {
    "url": "https://github.com/smndhm/dev-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smndhm/dev-config.git"
  },
  "license": "BSD-2-Clause",
  "author": {
    "name": "Simon Duhem",
    "email": "simon.duhem@gmail.com",
    "url": "https://simon.duhem.fr"
  },
  "type": "module",
  "packageManager": "pnpm@12.16.0",
  "bin": {
    "dev-config": "./bin/dev-config.js"
  },
  "files": [
    "lint/*.mjs",
    "lint/*.json",
    "a11y/index.js",
    "a11y/index.d.ts",
    "bin/dev-config.js",
    ".claude/settings.json",
    ".husky/pre-commit"
  ],
  "exports": {
    "./lint/prettier": "./lint/prettier.config.mjs",
    "./lint/oxlint.json": "./lint/oxlint.json",
    "./lint/eslint": "./lint/eslint.config.mjs",
    "./lint/stylelint": "./lint/stylelint.config.mjs",
    "./lint/lint-staged": "./lint/lint-staged.config.mjs",
    "./a11y": {
      "types": "./a11y/index.d.ts",
      "import": "./a11y/index.js"
    }
  },
  "prettier": "./lint/prettier.config.mjs",
  "scripts": {
    "dev-config": "node bin/dev-config.js",
    "prepare": "node bin/dev-config.js hooks",
    "lint": "prettier . --check && oxlint && eslint . && pnpm dev-config sync --check",
    "lint:fix": "prettier . --write && oxlint --fix && eslint . --fix",
    "test": "node --test 'a11y/*.test.js'",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "changeset:renovate": "changesets-renovate"
  },
  "dependencies": {
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "8.0.3",
    "axe-core": "4.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "stylelint-config-idiomatic-order": "10.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "stylelint-prettier": "5.0.3",
    "stylelint-use-logical": "2.1.3"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "oxlint": ">=1",
    "playwright": ">=1",
    "prettier": ">=3",
    "stylelint": ">=17"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@scaleway/changesets-renovate": "4.0.6",
    "eslint": "10.13.0",
    "oxlint": "1.90.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "stylelint": "17.16.0"
  }
}
