{
  "name": "@dume/linting",
  "version": "1.1.1",
  "description": "Linting configurations for my projects",
  "keywords": [
    "linting",
    "eslint",
    "oxlint",
    "prettier",
    "stylelint"
  ],
  "homepage": "https://github.com/smndhm/dev-config/tree/main/packages/linting#readme",
  "bugs": {
    "url": "https://github.com/smndhm/dev-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smndhm/dev-config.git",
    "directory": "packages/linting"
  },
  "license": "BSD-2-Clause",
  "author": {
    "name": "Simon Duhem",
    "email": "simon.duhem@gmail.com",
    "url": "https://simon.duhem.fr"
  },
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "import": "./src/index.js"
    },
    "./stylelint": {
      "import": "./src/stylelint.config.mjs"
    },
    "./prettier": {
      "import": "./src/prettier.config.mjs"
    },
    "./eslint": {
      "import": "./src/eslint.config.mjs"
    },
    "./oxlint": "./src/oxlint.json"
  },
  "main": "./src/index.js",
  "dependencies": {
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "8.0.3",
    "stylelint-config-idiomatic-order": "10.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-prettier": "5.0.3"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "prettier": ">=3",
    "stylelint": ">=17"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0"
  },
  "packageManager": "pnpm@12.14.0"
}
